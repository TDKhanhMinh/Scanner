{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Attendance Scanner",
  "version": "0.1.0",
  "identifier": "com.attendancescanner.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Attendance Scanner Desktop",
        "width": 1080,
        "height": 760,
        "minWidth": 800,
        "minHeight": 600,
        "visible": true,
        "center": true,
        "focus": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "externalBin": ["binaries/attendance-scanner-sidecar"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
